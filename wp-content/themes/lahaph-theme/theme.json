{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "primary-green",
          "color": "#46C449",
          "name": "Primary Green"
        },
        {
          "slug": "warm-yellow",
          "color": "#E2A21A",
          "name": "Warm Yellow"
        },
        {
          "slug": "soft-gray",
          "color": "#9EA0A3",
          "name": "Soft Gray"
        },
        {
          "slug": "sky-blue",
          "color": "#62C7E8",
          "name": "Sky Blue"
        },
        {
          "slug": "deep-navy",
          "color": "#1E2F6F",
          "name": "Deep Navy"
        },
        {
          "slug": "coral-red",
          "color": "#B53322",
          "name": "Coral Red"
        },
        {
          "slug": "purple-accent",
          "color": "#6F4B8B",
          "name": "Purple Accent"
        },
        {
          "slug": "olive-gold",
          "color": "#8C8A37",
          "name": "Olive Gold"
        },
        {
          "slug": "black",
          "color": "#222222",
          "name": "Black"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Sans",
          "fontFamily": "'Noto Sans KR', 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "1.5rem",
          "name": "X Large"
        },
        {
          "slug": "xx-large",
          "size": "2rem",
          "name": "XX Large"
        },
        {
          "slug": "hero",
          "size": "2.75rem",
          "name": "Hero"
        }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "10", "size": "0.5rem", "name": "XS" },
        { "slug": "20", "size": "1rem", "name": "S" },
        { "slug": "30", "size": "1.5rem", "name": "M" },
        { "slug": "40", "size": "2rem", "name": "L" },
        { "slug": "50", "size": "3rem", "name": "XL" },
        { "slug": "60", "size": "4.5rem", "name": "XXL" },
        { "slug": "70", "size": "6rem", "name": "XXXL" }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": true,
          "text": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "#FFFFFF",
      "text": "#222222"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "elements": {
      "h1": {
        "color": { "text": "var(--wp--preset--color--deep-navy)" },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--hero)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "h2": {
        "color": { "text": "var(--wp--preset--color--deep-navy)" },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)",
          "fontWeight": "700",
          "lineHeight": "1.3"
        }
      },
      "h3": {
        "color": { "text": "var(--wp--preset--color--deep-navy)" },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary-green)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--deep-navy)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary-green)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontWeight": "600"
        },
        "border": {
          "radius": "6px"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--deep-navy)"
          }
        }
      }
    }
  }
}
